# Copy to .env for local development. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Full Postgres connection string. In production (Render) this is provided
# automatically by the linked Render PostgreSQL instance — set it there as
# an environment variable, never hardcode it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/ruwad
# Render's managed Postgres requires SSL; local dev does not.
DATABASE_SSL=false

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Server -------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_URL=http://localhost:5174
