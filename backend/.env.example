# Copy to .env for local development. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Standard config for both development and production: Supabase Postgres.
# Copy the connection string from your Supabase project dashboard:
#   Project Settings → Database → Connection string → URI
# It looks like:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# If your network can't reach the direct host (IPv6-only), use the Session
# Pooler string from the same page instead (IPv4-compatible).
#
# IMPORTANT: any literal special character in the password (@, :, /, #, %,
# space, etc.) must be percent-encoded in the URL, e.g. "@" -> "%40" — an
# unescaped "@" in the password breaks URL parsing since "@" is also the
# delimiter before the host.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_SSL=true

# --- Local fallback (optional) ---------------------------------------------
# Only needed if you want to develop against the local embedded Postgres
# instead of Supabase (started by `npm run db:local`, see
# backend/scripts/local-postgres.js). Swap it in by commenting out the
# Supabase lines above and uncommenting these two instead:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/ruwad
# DATABASE_SSL=false

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- AI (resume-parse + pitch-deck autofill) ---------------------------------
# One Anthropic key (BACKEND ONLY) powers both: the signup wizard's "upload resume
# to autofill" (POST /api/resume-parse) and the submission forms' "Submit Your Pitch"
# deck autofill (POST /api/submissions/:id/autofill — PDF/PPTX up to 100 MB).
# Get a key from https://console.anthropic.com — without it those endpoints return
# 503 but the rest of the app is unaffected (both uploads are optional).
ANTHROPIC_API_KEY=
# Optional: model used to read pitch decks (default claude-haiku-4-5-20251001).
# A larger model reads long or dense decks more accurately, at higher cost.
# SUBMISSION_AUTOFILL_MODEL=

# --- Email (Resend) ---------------------------------------------------------
# Powers submission/Data Room/introduction notification emails. Get a key
# from https://resend.com — without it, email sends are skipped and logged
# only; nothing else in the app is affected (same graceful-degrade pattern
# as ANTHROPIC_API_KEY above).
RESEND_API_KEY=
# Sender shown on every email. Must be on a domain verified in Resend (karama.tech).
# Required: with no EMAIL_FROM, emails are skipped. In Render enter the value
# without surrounding quotes.
EMAIL_FROM=RUWĀD Platform <ruwadplatform@karama.tech>
# Base URL used to build links inside emails (no trailing slash) — the
# deployed frontend origin in production, not the backend's.
APP_URL=http://localhost:5174
# Inbox that receives admin-facing notifications (e.g. new startup
# submissions). Not a per-user address.
ADMIN_NOTIFICATION_EMAIL=ruwadplatform@gmail.com

# --- Server -------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_URL=http://localhost:5174

# ---- Automatic healthcare news and events (Serper.dev) ----
# BACKEND ONLY: the key is read from process.env.SERPER_API_KEY on the server and
# never sent to the frontend. Without it the feature is simply off and the app
# keeps showing whatever was collected before.
SERPER_API_KEY=
# Shared secret for POST /api/content-refresh/{news|events|all} (external
# scheduler / Render Cron Job). Leave empty to disable that endpoint.
CONTENT_REFRESH_TOKEN=
# In-process refresh (news every 6h, events every 12h, judged from the last run
# in the database). Set to false if you drive refreshes from an external scheduler.
CONTENT_REFRESH_INTERNAL=true

# ---- Google Calendar: "Add to Calendar" straight into the user's calendar ----
# BACKEND ONLY. Create a "Web application" OAuth client in Google Cloud (Calendar API
# enabled) and add GOOGLE_REDIRECT_URI as an authorized redirect URI. Without these the
# button falls back to the calendar links / .ics download.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full URL of this API's callback, e.g. https://<backend-host>/api/calendar/google/callback
GOOGLE_REDIRECT_URI=
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Encrypts stored Google tokens.
TOKEN_ENCRYPTION_KEY=
