# Copy to .env for local development. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Standard config for both development and production: Supabase Postgres.
# Copy the connection string from your Supabase project dashboard:
#   Project Settings → Database → Connection string → URI
# It looks like:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# If your network can't reach the direct host (IPv6-only), use the Session
# Pooler string from the same page instead (IPv4-compatible).
#
# IMPORTANT: any literal special character in the password (@, :, /, #, %,
# space, etc.) must be percent-encoded in the URL, e.g. "@" -> "%40" — an
# unescaped "@" in the password breaks URL parsing since "@" is also the
# delimiter before the host.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_SSL=true

# --- Local fallback (optional) ---------------------------------------------
# Only needed if you want to develop against the local embedded Postgres
# instead of Supabase (started by `npm run db:local`, see
# backend/scripts/local-postgres.js). Swap it in by commenting out the
# Supabase lines above and uncommenting these two instead:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/ruwad
# DATABASE_SSL=false

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- AI (resume-parse) ------------------------------------------------------
# Only needed for the signup wizard's "upload resume to autofill" feature
# (POST /api/resume-parse). Get a key from https://console.anthropic.com —
# without it, that one endpoint returns 503 but the rest of the app is
# unaffected (the resume upload is always optional on the signup form).
ANTHROPIC_API_KEY=

# --- Server -------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_URL=http://localhost:5174
