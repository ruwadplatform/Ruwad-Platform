# RUWĀD backend connection — the training CLI logs in once with these
# credentials (must belong to an admin account: RUWAD_ADMIN or SUPER_ADMIN
# role) and reuses the resulting JWT for every export/readiness/registry call.
RUWAD_API_BASE_URL=http://localhost:4000/api
RUWAD_ADMIN_EMAIL=
RUWAD_ADMIN_PASSWORD=

# Shared secret for inbound /predict* requests (NestJS -> this service).
# Must match the backend's own ML_SERVICE_TOKEN exactly (see
# backend/.env.example). Leave unset to make /predict* always reject —
# this service never accepts unauthenticated prediction traffic.
ML_SERVICE_TOKEN=

# Where trained model artifacts are saved (joblib + metadata.json per
# version). Defaults to ml/artifacts/ — never committed, see .gitignore.
ARTIFACT_DIR=

# FastAPI server
PORT=8001
HOST=127.0.0.1

# Reproducibility — the seed passed to every trainer's random_state
RANDOM_SEED=42

# ---- Production inference service (see docs/ml-experimental-inference.md) ----
# true  -> serve ONLY ML_EXPERIMENTAL_MODEL_VERSION, and only if its files match model_manifest.json (checked before unpickling).
#          /health answers 503 until that holds; interactive docs are off. Leave false/unset for local development.
REQUIRE_VERIFIED_ARTIFACTS=false
ML_EXPERIMENTAL_MODEL_VERSION=
# Production reads the packaged, manifest-pinned artifact:  ARTIFACT_DIR=model_artifacts
