{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsOidcMasterOnly",
      "Effect": "Allow",
      "Principal": { "Federated": "arn:aws:iam::699475958979:oidc-provider/token.actions.githubusercontent.com" },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:ruwadplatform/Ruwad-Platform:ref:refs/heads/master"
        }
      }
    }
  ]
}
